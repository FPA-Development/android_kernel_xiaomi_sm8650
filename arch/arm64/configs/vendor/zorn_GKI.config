# Charger
CONFIG_CHARGER_PARTITION=m
CONFIG_HL7603_BOOST=m
CONFIG_MI_DTPT=y
CONFIG_MI_O11_EMPTY_BATTERY=y

# Debug
CONFIG_MI_DUMP_DISPLAY=m
CONFIG_MTD=m
CONFIG_MTD_BLOCK=m
CONFIG_MTD_BLOCK2MTD=m
CONFIG_MTD_OOPS=m
CONFIG_REGMAP_QTI_DEBUGFS_ALLOW_WRITE=y

# Fingerprint
CONFIG_INPUT_FINGERPRINT=y
CONFIG_FINGERPRINT_MI_FP_ULTRA=m

# GPIO
CONFIG_MI_T1_CHIP=m

# HWID
CONFIG_MI_HARDWARE_ID=m

# IR
CONFIG_IR_SPI=m
CONFIG_LIRC=y
CONFIG_RC_CORE=y
CONFIG_RC_DECODERS=y
CONFIG_RC_DEVICES=y

# Memory
CONFIG_MI_MEM_ENGINE=m
CONFIG_QCOM_MEM_OFFLINE=m
CONFIG_ZRAM=m
CONFIG_ZSMALLOC=m

# MIHW
CONFIG_MIHW=y
CONFIG_MI_POWER_SAVE=m
CONFIG_MI_UNION_POWER=m

# Product
CONFIG_TARGET_PRODUCT_ZORN=y

# Regulator
CONFIG_REGULATOR_WL2866D=m

# Thermal
CONFIG_MI_THERMAL_INTERFACE=m
CONFIG_MI_THERMAL_MULTI_CHARGE=y

# Watchdog
CONFIG_QCOM_WATCHDOG_BARK_TIME=20000
CONFIG_QCOM_WATCHDOG_PET_TIME=15000
